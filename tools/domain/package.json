{
  "name": "@omedym/domain",
  "description": "Domain Generator",
  "version": "5.0.0",
  "license": "MIT",
  "main": "./dist/cli.js",
  "module": "./dist/cli.mjs",
  "types": "./dist/cli.d.ts",
  "exports": {
    "import": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "require": {
      "types": "./dist/cli.d.cts",
      "require": "./dist/cli.cjs"
    }
  },
  "bin": {
    "domain": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "domain": "tsx dist/cli.js",
    "build:tools": "tsup-node src/cli.ts --format cjs,esm --dts --clean --sourcemap && pnpm copy-templates",
    "copy-templates": "rimraf dist/templates && copyfiles --up 3 src/message_types/templates/*.hbs dist/templates/message_types && copyfiles --up 3 src/openapi/templates/*.hbs dist/templates/openapi",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config ../../vitest.integration.config.ts",
    "coverage": "vitest run --coverage"

  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@commander-js/extra-typings": "^10.0.3",
    "@faker-js/faker": "^8.4.1",
    "@inquirer/prompts": "^7.5.1",
    "@omedym/nestjs-dmq": "workspace:*",
    "@orval/core": "6.31.0",
    "class-transformer": "0.5.1",
    "colors-cli": "^1.0.32",
    "commander": "^10.0.0",
    "fast-glob": "^3.3.3",
    "glob": "^8.1.0",
    "graphql-js-tree": "^3.0.2",
    "handlebars-helpers": "^0.10.0",
    "handlebars": "^4.7.8",
    "immutable": "5.0.0-beta.5",
    "isolated-vm": "^5.0.4",
    "lodash": "^4.17.21",
    "luxon": "^2.5.2",
    "msw": "2.4.9",
    "nest-raven": "^10.1.0",
    "node-gyp": "10.2.0",
    "openapi-types": "^12.1.3",
    "orval": "6.31.0",
    "prettier-plugin-jsdoc": "0.x",
    "prettier": "^2.8.8",
    "safe-stable-stringify": "^2.4.3",
    "ts-json-schema-generator": "^2.3.0",
    "ts-morph": "24.0.0",
    "tslib": "^2.6.2",
    "typescript-string-operations": "^1.5.0",
    "typescript": "5.6.3",
    "yaml": "^2.3.1",
    "zod": "^3.23.8",
    "zod-validation-error": "^2.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.11.18",
    "@types/glob": "^8.1.0",
    "@types/handlebars-helpers": "^0.5.6",
    "@types/lodash": "^4.17.16",
    "@types/luxon": "^2.4.0",
    "@types/node": "^22",
    "@types/prettier": "^2.7.2",
    "@vitest/coverage-v8": "^3.1.1",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "cli"
  ]
}
