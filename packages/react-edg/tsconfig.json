{
	"extends": "../../../../tsconfig.turbo.json",
	"compilerOptions": {
		"baseUrl": ".",
		"jsx": "react-jsx",
		// Prevents the "React is not defined" error. For more context, refer to:
		// https://github.com/egoist/tsup/issues/792#issuecomment-1399614778
		"emitDecoratorMetadata": false,
    "module": "ESNext",
    "moduleResolution": "node",
		"outDir": "dist",
		"types": ["node"],
		"paths": {
			"@datagrid/*": ["src/*"]
		}
	},
	"include": ["./src"],
	"exclude": ["node_modules"]
}
