{
  "name": "@omedym/nestjs-telemetry",
  "version": "5.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "pnpm check-types && tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config ../../../../vitest.integration.config.ts",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apollo/server": "^4.9.1",
    "@nestjs/apollo": "^12.2.1",
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/graphql": "^12.2.1",
    "@sentry/aws-serverless": "^9.11.0",
    "@sentry/core": "^9.11.0",
    "@sentry/nestjs": "^9.11.0",
    "@sentry/node": "^9.11.0",
    "@sentry/profiling-node": "^9.11.0",
    "chalk": "^4.1.2",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "logform": "^2.5.1",
    "luxon": "^2.5.2",
    "nest-raven": "^10.1.0",
    "nestjs-cls": "^4.4.1",
    "safe-stable-stringify": "^2.4.3",
    "serialize-error": "^8.1",
    "tslib": "^2.6.2",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.8",
    "@swc/core": "^1.11.18",
    "@types/luxon": "^2.4.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.1.1",
    "tsup": "^8.4.0",
    "vitest": "^3.1.1",
    "vitest-mock-extended": "^3.1.0"
  },
  "keywords": [
    "nestjs",
    "sentry",
    "graphql"
  ]
}
